{
  "config": {
    // a reference heading is a signature, and its anchor is built from it
    "MD013": { "line_length": 120, "tables": false, "code_blocks": false, "headings": false },
    // the changelog and the reference repeat a heading under different parents
    "MD024": { "siblings_only": true },
    // the docs embed HTML: the README's icon, VitePress containers
    "MD033": false,
    // VitePress builds heading anchors differently from markdownlint's GitHub slugs (`0.0.2` -> `0-0-2`)
    "MD051": false
  },
  "ignores": [".venv/**", "**/node_modules/**", "**/dist/**", "coverage/**", "docs/.vitepress/cache/**"]
}
