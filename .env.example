# Copy to .env (not in git) and fill in. Variables set in the environment take precedence.
# A dedicated user with CREATEDB, not a superuser; percent-encode reserved characters of the
# password (e.g. [ -> %5B, ] -> %5D, @ -> %40).
ADORM_TEST_DATABASE_URL=postgres://adorm:password@127.0.0.1:5432/adorm_test
ADORM_DEMO_DATABASE_URL=postgres://adorm:password@127.0.0.1:5432/adorm_demo
