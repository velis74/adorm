{
  "name": "adorm-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs",
    "demo/frontend",
    "demo/e2e"
  ],
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs",
    "demo:dev": "npm run dev -w adorm-demo-frontend",
    "demo:build": "npm run build -w adorm-demo-frontend",
    "test:e2e": "npm run demo:build && npm run test:e2e -w adorm-demo-e2e"
  },
  "devDependencies": {
    "eslint-config-velis": "^3.0.1",
    "markdownlint-cli2": "^0.18.1"
  }
}
